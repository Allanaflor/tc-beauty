            </div>
            <div id="listaFeedbacksAdmin"></div>
        </div>

    </div>

    <div class="toast" id="toast">
        <div class="toast-titulo" id="toastTitulo">✨ Sucesso!</div>
        <div class="toast-texto" id="toastTexto">Ação realizada com sucesso.</div>
    </div>

    <script>
