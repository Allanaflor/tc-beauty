        { id: 20, nome: 'Batom Chocolatte', preco: 10.00, precoAntigo: null, categoria: 'Maquiagem', destaque: false, vendidos: 156, parcelas: '2x de R$ 5,00 sem juros', imagem: 'https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=400&h=400&fit=crop&q=80&sat=16' },
        { id: 21, nome: 'Batom Rosa Intenso', preco: 10.00, precoAntigo: null, categoria: 'Maquiagem', destaque: false, vendidos: 178, parcelas: '2x de R$ 5,00 sem juros', imagem: 'https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=400&h=400&fit=crop&q=80&sat=17' },
        { id: 22, nome: 'Batom Glossy Pink', preco: 10.00, precoAntigo: null, categoria: 'Maquiagem', destaque: false, vendidos: 145, parcelas: '2x de R$ 5,00 sem juros', imagem: 'https://images.unsplash.com/photo-1512496015851-a90fb38ba796?w=400&h=400&fit=crop&q=80&sat=18' },
        { id: 23, nome: 'Gloss Diamond', preco: 10.00, precoAntigo: 20.00, categoria: 'Maquiagem', destaque: true, vendidos: 412, parcelas: '2x de R$ 5,00 sem juros', imagem: 'https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?w=400&h=400&fit=crop&q=80' },
        { id: 24, nome: 'Gloss Cintilante', preco: 10.00, precoAntigo: 20.00, categoria: 'Maquiagem', destaque: true, vendidos: 367, parcelas: '2x de R$ 5,00 sem juros', imagem: 'https://images.unsplash.com/photo-1625093742435-6fa192b6fb10?w=400&h=400&fit=crop&q=80' },
        { id: 25, nome: 'Gloss Vermelho Intenso', preco: 10.00, precoAntigo: null, categoria: 'Maquiagem', destaque: false, vendidos: 234, parcelas: '2x de R$ 5,00 sem juros', imagem: 'https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?w=400&h=400&fit=crop&q=80&sat=20' },
        { id: 26, nome: 'Gloss Dourado', preco: 10.00, precoAntigo: null, categoria: 'Maquiagem', destaque: false, vendidos: 187, parcelas: '2x de R$ 5,00 sem juros', imagem: 'https://images.unsplash.com/photo-1625093742435-6fa192b6fb10?w=400&h=400&fit=crop&q=80&sat=21' },
        { id: 27, nome: 'Gloss Lilás', preco: 10.00, precoAntigo: null, categoria: 'Maquiagem', destaque: false, vendidos: 165, parcelas: '2x de R$ 5,00 sem juros', imagem: 'https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?w=400&h=400&fit=crop&q=80&sat=22' },
        { id: 28, nome: 'Gloss Pink', preco: 10.00, precoAntigo: null, categoria: 'Maquiagem', destaque: false, vendidos: 198, parcelas: '2x de R$ 5,00 sem juros', imagem: 'https://images.unsplash.com/photo-1625093742435-6fa192b6fb10?w=400&h=400&fit=crop&q=80&sat=23' },
        { id: 29, nome: 'Gloss Transparente', preco: 10.00, precoAntigo: null, categoria: 'Maquiagem', destaque: false, vendidos: 156, parcelas: '2x de R$ 5,00 sem juros', imagem: 'https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?w=400&h=400&fit=crop&q=80&sat=24' },
        { id: 30, nome: 'Gloss Black', preco: 10.00, precoAntigo: null, categoria: 'Maquiagem', destaque: false, vendidos: 123, parcelas: '2x de R$ 5,00 sem juros', imagem: 'https://images.unsplash.com/photo-1625093742435-6fa192b6fb10?w=400&h=400&fit=crop&q=80&sat=25' }
    ];

    let imagemAtual = null;
    let produtosCache = [];
    let clientesCache = [];
    let agendamentosCache = [];
    let clientesConhecidos = new Set();
    let agendamentosConhecidos = new Set();
    let primeiraCargaClientes = true;
    let primeiraCargaAgend = true;
    let filtroStatusAgend = 'todos';
    let filtroPeriodoAgend = 'todos';

    const storage = {
        get(key) {
            try { return JSON.parse(localStorage.getItem(key)) || []; }
            catch { return []; }
        },
        set(key, val) {
            try { localStorage.setItem(key, JSON.stringify(val)); return true; }
            catch {
                toast('⚠️ Armazenamento cheio!', 'Reduza imagens ou remova itens antigos.');
                return false;
            }
        }
    };

    const getProdutos = () => storage.get(STORAGE_KEYS.produtos);
    const setProdutos = (v) => storage.set(STORAGE_KEYS.produtos, v);
    const getAvaliacoes = () => storage.get(STORAGE_KEYS.avaliacoes);
    const setAvaliacoes = (v) => storage.set(STORAGE_KEYS.avaliacoes, v);
    const getFeedbacks = () => storage.get(STORAGE_KEYS.feedbacks);
    const setFeedbacks = (v) => storage.set(STORAGE_KEYS.feedbacks, v);
    const getFavoritos = () => storage.get(STORAGE_KEYS.favoritos);
    const getClientes = () => storage.get(STORAGE_KEYS.clientes);
    const setClientes = (v) => storage.set(STORAGE_KEYS.clientes, v);
    const getAgendamentos = () => storage.get(STORAGE_KEYS.agendamentos);
    const setAgendamentos = (v) => storage.set(STORAGE_KEYS.agendamentos, v);

    function resolverImagem(src) {
        if (!src) return '../placeholder.jpg';
        const s = String(src).trim();
        if (s.startsWith('data:') || s.startsWith('http') || s.startsWith('blob:') || s.startsWith('/')) return s;
        return '../' + s;
    }

    function estaOnline(cliente) {
        if (!cliente?.ultimoAcesso) return false;
        return (Date.now() - new Date(cliente.ultimoAcesso).getTime()) < TEMPO_ONLINE_MS;
    }

    function iniciais(nome) {
        if (!nome) return '?';
        return nome.trim().split(/\s+/).slice(0, 2).map(n => n[0]).join('').toUpperCase();
    }

    function formatarDataHora(iso) {
        if (!iso) return '—';
        try {
            const d = new Date(iso);
            const dia = String(d.getDate()).padStart(2, '0');
            const mes = String(d.getMonth() + 1).padStart(2, '0');
            const ano = d.getFullYear();
            const hora = String(d.getHours()).padStart(2, '0');
            const min = String(d.getMinutes()).padStart(2, '0');
            return `${dia}/${mes}/${ano} às ${hora}:${min}`;
        } catch { return '—'; }
    }

    function formatarDataBR(dataISO) {
        if (!dataISO) return '—';
        const p = String(dataISO).split('-');
        if (p.length !== 3) return dataISO;
        return `${p[2]}/${p[1]}/${p[0]}`;
    }

    function hojeISO() {
        const d = new Date();
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }

    function formatarValor(v) {
        if (v == null || v === '') return '';
        const n = Number(v);
        if (isNaN(n)) return '';
        return `R$ ${n.toFixed(2).replace('.', ',')}`;
    }

    function initDados() {
        const seedKey = 'tcbeauty_produtos_seed';
        if (localStorage.getItem(seedKey) !== PRODUTOS_SEED_VERSION) {
            setProdutos(PRODUTOS_INICIAIS);
            localStorage.setItem(seedKey, PRODUTOS_SEED_VERSION);
        } else if (getProdutos().length === 0) {
            setProdutos(PRODUTOS_INICIAIS);
        }

        if (getAvaliacoes().length === 0) {
            setAvaliacoes([
                { nome: 'Maria Silva', produto: 'Base Matte Premium', nota: 5, texto: 'Produto maravilhoso! Minha pele ficou perfeita.', data: '10/01/2026', curtidas: 12 },
                { nome: 'Fernanda Lima', produto: 'Batom Matte Luxo', nota: 5, texto: 'Amei a cor e a durabilidade. Super recomendo!', data: '08/01/2026', curtidas: 8 },
                { nome: 'Camila Rocha', produto: 'Gloss Diamond', nota: 4, texto: 'Muito bonito, brilho incrível.', data: '05/01/2026', curtidas: 4 },
                { nome: 'Ana Paula', produto: 'Base Iluminadora', nota: 5, texto: 'Cobertura perfeita e iluminada.', data: '03/01/2026', curtidas: 15 }
            ]);
        }

        if (getFeedbacks().length === 0) {
            setFeedbacks([
                { nome: 'Cliente 1', texto: 'Loja incrível, produtos de qualidade e entrega rápida!' },
                { nome: 'Cliente 2', texto: 'Atendimento excelente, tirei todas minhas dúvidas.' }
            ]);
        }

        if (getAgendamentos().length === 0 && !localStorage.getItem('tcbeauty_agend_seed')) {
            const hoje = hojeISO();
            setAgendamentos([
                { id: 'ag1', clienteNome: 'Maria Silva', clienteTelefone: '(11) 98765-4321', clienteFoto: '',
                  servico: 'Maquiagem para Festa', profissional: 'Luíza',
                  data: hoje, hora: '14:00', valor: 150, status: 'pendente',
                  observacoes: 'Cliente quer maquiagem iluminada.', criadoEm: new Date().toISOString() },
                { id: 'ag2', clienteNome: 'Fernanda Lima', clienteTelefone: '(21) 99123-4567', clienteFoto: '',
                  servico: 'Design de Sobrancelhas', profissional: 'Luíza',
                  data: hoje, hora: '16:30', valor: 60, status: 'confirmado',
                  observacoes: '', criadoEm: new Date().toISOString() }
            ]);
            localStorage.setItem('tcbeauty_agend_seed', '1');
        }
    }

    function fazerLogin() {
        const usuario = document.getElementById('loginUsuario').value.trim();
        const senha = document.getElementById('loginSenha').value.trim();
        const erro = document.getElementById('loginErro');

        if (usuario === CREDENCIAIS.usuario && senha === CREDENCIAIS.senha) {
            erro.style.display = 'none';
            document.getElementById('telaLogin').style.display = 'none';
            document.getElementById('painel').style.display = 'block';
            document.getElementById('usuarioNome').textContent = 'Luíza';
            carregarDados();
            iniciarMonitor();
            toast('🔐 Bem-vinda!', 'Você entrou no Painel Administrativo.');
        } else {
            erro.style.display = 'block';
            toast('❌ Acesso negado!', 'Usuário ou senha incorretos.');
        }
    }

    function sair() {
        document.getElementById('painel').style.display = 'none';
        document.getElementById('telaLogin').style.display = 'flex';
        document.getElementById('loginUsuario').value = 'luiza';
        document.getElementById('loginSenha').value = '123456';
        document.getElementById('loginErro').style.display = 'none';
        pararMonitor();
        toast('👋 Até logo!', 'Você saiu do painel administrativo.');
    }

    function carregarDados() {
        carregarProdutos();
        carregarAgendamentos();
        carregarClientes();
        carregarAvaliacoesAdmin();
        carregarFeedbacksAdmin();
        atualizarStats();
    }

    function carregarProdutos() {
        produtosCache = getProdutos();
        document.getElementById('produtosBadge').textContent = produtosCache.length;
        renderizarTabelaProdutos(produtosCache);
    }

    function renderizarTabelaProdutos(lista) {
        const tbody = document.getElementById('tabelaProdutos');
        if (!lista.length) {
            tbody.innerHTML = `
                <tr><td colspan="5" class="vazio">
                    <i class="fa-regular fa-box"></i>
                    Nenhum produto encontrado.<br>
                    <span style="font-size:12px;color:#555;">
                        ${produtosCache.length ? 'Tente outra busca.' : 'Clique em "Novo Produto".'}
                    </span>
                </td></tr>`;
            return;
        }
        tbody.innerHTML = lista.map(p => {
            const src = resolverImagem(p.imagem);
            const precoFmt = `R$ ${Number(p.preco).toFixed(2).replace('.', ',')}`;
            const antigoFmt = p.precoAntigo ? `<span class="produto-preco-antigo">R$ ${Number(p.precoAntigo).toFixed(2).replace('.', ',')}</span>` : '';
            return `
                <tr>
                    <td><img src="${src}" alt="${escaparHTML(p.nome)}" class="produto-img" onerror="this.onerror=null;this.src='../placeholder.jpg'" /></td>
                    <td>
                        <div class="produto-nome">${escaparHTML(p.nome)}</div>
                        ${p.parcelas ? `<div class="produto-parcelas">${escaparHTML(p.parcelas)}</div>` : ''}
                    </td>
                    <td><span class="produto-categoria">${escaparHTML(p.categoria)}</span></td>
                    <td><span class="produto-preco">${precoFmt}</span>${antigoFmt}</td>
                    <td>
                        <div class="acoes">
                            <button class="btn-editar" onclick="editarProduto(${p.id})" title="Editar">
                                <i class="fa-regular fa-pen"></i>
                            </button>
                            <button class="btn-excluir" onclick="excluirProduto(${p.id})" title="Excluir">
                                <i class="fa-regular fa-trash-can"></i>
                            </button>
                        </div>
                    </td>
                </tr>`;
        }).join('');
    }

    function filtrarProdutos() {
        const termo = document.getElementById('buscaProduto').value.trim().toLowerCase();
        if (!termo) { renderizarTabelaProdutos(produtosCache); return; }
        const filtrados = produtosCache.filter(p =>
            p.nome.toLowerCase().includes(termo) || p.categoria.toLowerCase().includes(termo)
        );
        renderizarTabelaProdutos(filtrados);
    }

    function abrirFormProduto(produto = null) {
        const form = document.getElementById('formProduto');
        const titulo = document.getElementById('formProdutoTitulo');
        limparImagem();
        document.getElementById('buscaProduto').value = '';

        if (produto) {
            titulo.textContent = '✏️ Editar Produto';
            document.getElementById('produtoEditId').value = produto.id;
            document.getElementById('produtoNome').value = produto.nome;
            document.getElementById('produtoPreco').value = produto.preco;
            document.getElementById('produtoPrecoAntigo').value = produto.precoAntigo ?? '';
            document.getElementById('produtoCategoria').value = produto.categoria;
            document.getElementById('produtoParcelas').value = produto.parcelas || '';
            document.getElementById('produtoDestaque').value = produto.destaque ? 'true' : 'false';
            document.getElementById('produtoVendidos').value = produto.vendidos || 0;
            const img = produto.imagem || '';
            if (img.startsWith('data:')) {
                imagemAtual = img;
                document.getElementById('produtoImagem').placeholder = 'Imagem enviada do dispositivo ✓';
            } else {
                document.getElementById('produtoImagem').value = img;
            }
            atualizarPreview(img);
        } else {
            titulo.textContent = '📦 Adicionar Produto';
            document.getElementById('produtoEditId').value = '';
            document.getElementById('produtoNome').value = '';
            document.getElementById('produtoPreco').value = '';
            document.getElementById('produtoPrecoAntigo').value = '';
            document.getElementById('produtoCategoria').value = 'Maquiagem';
            document.getElementById('produtoParcelas').value = '';
            document.getElementById('produtoDestaque').value = 'true';
            document.getElementById('produtoVendidos').value = '0';
        }

        form.classList.add('aberto');
        setTimeout(() => form.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
    }

    function fecharFormProduto() {
        document.getElementById('formProduto').classList.remove('aberto');
        limparImagem();
    }

    function uploadImagemLocal(event) {
        const file = event.target.files?.[0];
        if (!file) return;
        if (!file.type.startsWith('image/')) {
            toast('⚠️ Arquivo inválido', 'Selecione uma imagem (JPG, PNG, WEBP...).');
            event.target.value = '';
            return;
        }
        if (file.size > TAMANHO_MAX_IMG) {
            toast('⚠️ Imagem muito grande', 'Escolha uma imagem com até 900KB.');
            event.target.value = '';
            return;
        }
        const reader = new FileReader();
        reader.onload = (e) => {
            imagemAtual = e.target.result;
            document.getElementById('produtoImagem').value = '';
            document.getElementById('produtoImagem').placeholder = 'Imagem enviada do dispositivo ✓';
            atualizarPreview(imagemAtual);
            toast('🖼️ Imagem carregada!', 'A pré-visualização está pronta.');
        };
        reader.readAsDataURL(file);
    }

    function onUrlImagemChange() {
        const url = document.getElementById('produtoImagem').value.trim();
        imagemAtual = null;
        atualizarPreview(url);
    }

    function atualizarPreview(src) {
        const preview = document.getElementById('imagemPreview');
        const real = src || imagemAtual;
        if (real) {
            preview.classList.add('tem-imagem');
            preview.innerHTML = `<img src="${resolverImagem(real)}" alt="Preview" onerror="this.onerror=null;this.parentElement.classList.remove('tem-imagem');this.parentElement.innerHTML='<i class=\\'fa-regular fa-image\\'></i>';" />`;
        } else {
            preview.classList.remove('tem-imagem');
            preview.innerHTML = `<i class="fa-regular fa-image"></i>`;
        }
    }

    function limparImagem() {
        imagemAtual = null;
        const fileInput = document.getElementById('produtoImagemFile');
        const urlInput = document.getElementById('produtoImagem');
        if (fileInput) fileInput.value = '';
        if (urlInput) {
            urlInput.value = '';
            urlInput.placeholder = 'Cole a URL ou o nome do arquivo (ex: batom.jpg)';
        }
        atualizarPreview('');
    }

    function salvarProduto() {
        const id = document.getElementById('produtoEditId').value;
        const nome = document.getElementById('produtoNome').value.trim();
        const precoRaw = document.getElementById('produtoPreco').value;
        const precoAntigoRaw = document.getElementById('produtoPrecoAntigo').value;
        const categoria = document.getElementById('produtoCategoria').value;
        const parcelas = document.getElementById('produtoParcelas').value.trim();
        const destaque = document.getElementById('produtoDestaque').value === 'true';
        const vendidos = parseInt(document.getElementById('produtoVendidos').value) || 0;
        const urlDigitada = document.getElementById('produtoImagem').value.trim();
        const imagem = imagemAtual || urlDigitada;

        if (!nome) { toast('⚠️ Atenção!', 'Informe o nome do produto.'); return; }
        const preco = parseFloat(precoRaw);
        if (!precoRaw || isNaN(preco) || preco <= 0) { toast('⚠️ Atenção!', 'Informe um preço válido.'); return; }
        if (!imagem) { toast('⚠️ Atenção!', 'Adicione uma imagem ao produto.'); return; }

        const precoAntigo = precoAntigoRaw ? parseFloat(precoAntigoRaw) : null;
        const produtos = getProdutos();

        if (id) {
            const idx = produtos.findIndex(p => p.id === parseInt(id));
            if (idx === -1) { toast('❌ Erro', 'Produto não encontrado.'); return; }
            produtos[idx] = { ...produtos[idx], nome, preco, precoAntigo, categoria, parcelas, imagem, destaque, vendidos };
            if (!setProdutos(produtos)) return;
            toast('✅ Produto atualizado!', `"${nome}" foi atualizado.`);
        } else {
            const novoId = produtos.length ? Math.max(...produtos.map(p => p.id)) + 1 : 1;
            produtos.push({ id: novoId, nome, preco, precoAntigo, categoria, parcelas, imagem, destaque, vendidos });
            if (!setProdutos(produtos)) return;
            toast('✅ Produto adicionado!', `"${nome}" foi cadastrado.`);
        }

        fecharFormProduto();
        carregarProdutos();
        atualizarStats();
    }

    function editarProduto(id) {
        const produto = getProdutos().find(p => p.id === id);
        if (produto) abrirFormProduto(produto);
    }

    function excluirProduto(id) {
        const produto = getProdutos().find(p => p.id === id);
        if (!produto) return;
        if (!confirm(`Excluir "${produto.nome}"?`)) return;
        setProdutos(getProdutos().filter(p => p.id !== id));
        carregarProdutos();
        atualizarStats();
        toast('🗑️ Produto excluído!', `"${produto.nome}" foi removido.`);
    }

    function carregarAgendamentos() {
        agendamentosCache = getAgendamentos();
        atualizarContadoresAgend();
        renderizarAgendamentos();
    }

    function atualizarContadoresAgend() {
        const all = agendamentosCache;
        const hoje = hojeISO();
        const contar = (status) => all.filter(a => a.status === status).length;

        document.getElementById('agendBadge').textContent = all.length;
        document.getElementById('agendPendentesBadge').textContent = `${contar('pendente')} pendentes`;
        document.getElementById('cont-todos').textContent = all.length;
        document.getElementById('cont-pendente').textContent = contar('pendente');
        document.getElementById('cont-confirmado').textContent = contar('confirmado');
        document.getElementById('cont-concluido').textContent = contar('concluido');
        document.getElementById('cont-cancelado').textContent = contar('cancelado');

        document.getElementById('statAgendHoje').textContent = all.filter(a => a.data === hoje && a.status !== 'cancelado').length;
        document.getElementById('statAgendPendentes').textContent = contar('pendente');
    }

    function setFiltroAgend(status, btn) {
        filtroStatusAgend = status;
        document.querySelectorAll('#agendFiltrosStatus .filtro-chip').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        renderizarAgendamentos();
    }

    function setPeriodoAgend(periodo, btn) {
        filtroPeriodoAgend = periodo;
        document.querySelectorAll('#agendFiltrosData .filtro-chip').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        renderizarAgendamentos();
    }

    function filtrarPorPeriodo(lista) {
        const hoje = new Date(); hoje.setHours(0, 0, 0, 0);
        const hojeIso = hojeISO();
        if (filtroPeriodoAgend === 'hoje') return lista.filter(a => a.data === hojeIso);
        if (filtroPeriodoAgend === 'semana') {
            const limite = new Date(hoje); limite.setDate(limite.getDate() + 7);
            return lista.filter(a => {
                if (!a.data) return false;
                const d = new Date(a.data + 'T00:00:00');
                return d >= hoje && d <= limite;
            });
        }
        if (filtroPeriodoAgend === 'passado') return lista.filter(a => a.data < hojeIso);
        return lista;
    }

    function renderizarAgendamentos() {
        const container = document.getElementById('listaAgendamentos');
        let lista = agendamentosCache;
        if (filtroStatusAgend !== 'todos') lista = lista.filter(a => a.status === filtroStatusAgend);
        lista = filtrarPorPeriodo(lista);
        lista = [...lista].sort((a, b) => {
            const da = `${a.data || ''}T${a.hora || '00:00'}`;
            const db = `${b.data || ''}T${b.hora || '00:00'}`;
            return da.localeCompare(db);
        });

        if (!lista.length) {
            container.innerHTML = `
                <div class="vazio" style="grid-column: 1/-1;">
                    <i class="fa-regular fa-calendar"></i>
                    ${agendamentosCache.length ? 'Nenhum agendamento com esses filtros.' : 'Nenhum agendamento ainda.<br><span style="font-size:12px;color:#555;">Quando um cliente agendar na loja, aparecerá aqui.</span>'}
                </div>`;
            return;
        }

        container.innerHTML = lista.map(a => {
            const statusLabel = { pendente: 'Pendente', confirmado: 'Confirmado', concluido: 'Concluído', cancelado: 'Cancelado' };
            const statusIcon = { pendente: 'fa-hourglass-half', confirmado: 'fa-circle-check', concluido: 'fa-circle-check', cancelado: 'fa-circle-xmark' };
            const avatar = a.clienteFoto
                ? `<img src="${resolverImagem(a.clienteFoto)}" alt="${escaparHTML(a.clienteNome)}" onerror="this.parentElement.innerHTML='${iniciais(a.clienteNome)}';" />`
                : iniciais(a.clienteNome);

            let acoes = '';
            if (a.status === 'pendente') {
                acoes = `
                    <button class="btn-confirmar" onclick="mudarStatusAgend('${escaparHTML(a.id)}', 'confirmado')">
                        <i class="fa-solid fa-check"></i> Confirmar
                    </button>
                    <button class="btn-cancelar-ag" onclick="mudarStatusAgend('${escaparHTML(a.id)}', 'cancelado')">
                        <i class="fa-solid fa-xmark"></i> Cancelar
                    </button>`;
            } else if (a.status === 'confirmado') {
                acoes = `
                    <button class="btn-concluir" onclick="mudarStatusAgend('${escaparHTML(a.id)}', 'concluido')">
                        <i class="fa-solid fa-flag-checkered"></i> Concluir
                    </button>
                    <button class="btn-cancelar-ag" onclick="mudarStatusAgend('${escaparHTML(a.id)}', 'cancelado')">
                        <i class="fa-solid fa-xmark"></i> Cancelar
                    </button>`;
            } else if (a.status === 'concluido') {
                acoes = `<button onclick="excluirAgendamento('${escaparHTML(a.id)}')" class="btn-excluir-ag">
                        <i class="fa-regular fa-trash-can"></i> Remover
                    </button>`;
            } else {
                acoes = `
                    <button onclick="mudarStatusAgend('${escaparHTML(a.id)}', 'pendente')">
                        <i class="fa-solid fa-rotate-left"></i> Reabrir
                    </button>
                    <button onclick="excluirAgendamento('${escaparHTML(a.id)}')" class="btn-excluir-ag">
                        <i class="fa-regular fa-trash-can"></i> Excluir
                    </button>`;
            }

            return `
                <div class="agend-card status-${a.status}">
                    <div class="agend-header">
                        <div class="agend-cliente">
                            <div class="agend-avatar">${avatar}</div>
                            <div style="min-width:0;">
                                <div class="nome">${escaparHTML(a.clienteNome || 'Cliente')}</div>
                                ${a.clienteTelefone ? `<div class="tel"><i class="fa-solid fa-phone" style="font-size:10px;"></i> ${escaparHTML(a.clienteTelefone)}</div>` : ''}
                            </div>
                        </div>
                        <span class="status-badge ${a.status}">
                            <i class="fa-regular ${statusIcon[a.status]}"></i>
                            ${statusLabel[a.status] || a.status}
                        </span>
                    </div>

                    <div class="agend-detalhes">
                        <div class="agend-detalhe">
                            <i class="fa-regular fa-calendar"></i>
                            <span><strong>${formatarDataBR(a.data)}</strong></span>
                        </div>
                        <div class="agend-detalhe">
                            <i class="fa-regular fa-clock"></i>
                            <span><strong>${escaparHTML(a.hora || '--:--')}</strong></span>
                        </div>
                        <div class="agend-detalhe">
                            <i class="fa-regular fa-sparkles"></i>
                            <span>${escaparHTML(a.servico || 'Serviço')}</span>
                        </div>
                        ${a.profissional ? `<div class="agend-detalhe"><i class="fa-regular fa-user-tie"></i><span>${escaparHTML(a.profissional)}</span></div>` : ''}
                        ${a.valor ? `<div class="agend-detalhe"><i class="fa-solid fa-tag"></i><span>${formatarValor(a.valor)}</span></div>` : ''}
                        <div class="agend-detalhe">
                            <i class="fa-regular fa-calendar-plus"></i>
                            <span style="font-size:11px;color:#666;">Criado ${formatarDataHora(a.criadoEm)}</span>
                        </div>
                    </div>

                    ${a.observacoes ? `<div class="agend-obs"><i class="fa-regular fa-note-sticky"></i> ${escaparHTML(a.observacoes)}</div>` : ''}

                    <div class="agend-acoes">${acoes}</div>
                </div>`;
        }).join('');
    }

    function mudarStatusAgend(id, novoStatus) {
        const lista = getAgendamentos();
        const idx = lista.findIndex(a => String(a.id) === String(id));
        if (idx === -1) return;
        lista[idx].status = novoStatus;
        lista[idx].atualizadoEm = new Date().toISOString();
        if (!setAgendamentos(lista)) return;
        carregarAgendamentos();
        atualizarStats();
        const label = { confirmado: 'confirmado', concluido: 'concluído', cancelado: 'cancelado', pendente: 'reaberto' };
        toast('✅ Status atualizado!', `Agendamento ${label[novoStatus] || novoStatus}.`);
    }

    function excluirAgendamento(id) {
        const a = getAgendamentos().find(x => String(x.id) === String(id));
        if (!a) return;
        if (!confirm(`Excluir o agendamento de "${a.clienteNome}"?`)) return;
        setAgendamentos(getAgendamentos().filter(x => String(x.id) !== String(id)));
        carregarAgendamentos();
        atualizarStats();
        toast('🗑️ Agendamento excluído', `O agendamento de "${a.clienteNome}" foi removido.`);
    }

    function limparAgendamentos(status) {
        const alvo = getAgendamentos().filter(a => a.status === status);
        if (!alvo.length) { toast('ℹ️ Nada para limpar', `Não há agendamentos com status "${status}".`); return; }
        if (!confirm(`Excluir TODOS os ${alvo.length} agendamentos com status "${status}"?`)) return;
        setAgendamentos(getAgendamentos().filter(a => a.status !== status));
        carregarAgendamentos();
        atualizarStats();
        toast('🧹 Lista limpa!', `${alvo.length} agendamentos removidos.`);
    }

    function carregarClientes() {
        clientesCache = getClientes();
        atualizarBadgesClientes();
        renderizarClientes();
    }

    function atualizarBadgesClientes() {
        const total = clientesCache.length;
        const online = clientesCache.filter(estaOnline).length;
        document.getElementById('clientesBadge').textContent = total;
        document.getElementById('clientesOnlineBadge').textContent = `${online} online`;
        document.getElementById('statClientes').textContent = total;
        document.getElementById('statOnline').textContent = online;
    }

    function renderizarClientes() {
        const container = document.getElementById('listaClientes');
        const termo = (document.getElementById('buscaCliente')?.value || '').trim().toLowerCase();

        const ordenados = [...clientesCache].sort((a, b) => {
            const aOn = estaOnline(a), bOn = estaOnline(b);
            if (aOn !== bOn) return bOn - aOn;
            return new Date(b.ultimoAcesso || 0) - new Date(a.ultimoAcesso || 0);
        });

        const lista = termo
            ? ordenados.filter(c =>
                (c.nome || '').toLowerCase().includes(termo) ||
                (c.email || '').toLowerCase().includes(termo) ||
                (c.telefone || '').toLowerCase().includes(termo))
            : ordenados;

        if (!lista.length) {
            container.innerHTML = `
                <div class="vazio" style="grid-column: 1 / -1;">
                    <i class="fa-regular fa-users"></i>
                    ${clientesCache.length ? 'Nenhum cliente corresponde à busca.' : 'Nenhum cliente logou ainda.<br><span style="font-size:12px;color:#555;">Assim que alguém entrar na loja, aparecerá aqui.</span>'}
                </div>`;
            return;
        }

        container.innerHTML = lista.map(c => {
            const online = estaOnline(c);
            const avatar = c.foto
                ? `<img src="${resolverImagem(c.foto)}" alt="${escaparHTML(c.nome || '')}" onerror="this.parentElement.innerHTML='${iniciais(c.nome)}';" />`
                : iniciais(c.nome);

            return `
                <div class="cliente-card ${online ? 'online' : ''}">
                    <div class="cliente-avatar">
                        ${avatar}
                        ${online ? '<span class="status-online" title="Online"></span>' : ''}
                    </div>
                    <div class="cliente-info">
                        <div class="nome">
                            ${escaparHTML(c.nome || 'Sem nome')}
                            ${online ? '<span class="badge-online">● ONLINE</span>' : ''}
                        </div>
                        ${c.email ? `<div class="linha"><i class="fa-regular fa-envelope"></i><span class="valor">${escaparHTML(c.email)}</span></div>` : ''}
                        ${c.telefone ? `<div class="linha"><i class="fa-solid fa-phone"></i><span class="valor">${escaparHTML(c.telefone)}</span></div>` : ''}
                        ${c.cidade ? `<div class="linha"><i class="fa-solid fa-location-dot"></i><span class="valor">${escaparHTML(c.cidade)}</span></div>` : ''}
                        <div class="linha">
                            <i class="fa-regular fa-clock"></i>
                            <span class="valor" title="Último acesso">
                                ${online ? 'Entrou ' : 'Entrou em '} ${formatarDataHora(c.ultimoAcesso || c.dataLogin)}
                            </span>
                        </div>
                    </div>
                    <button class="btn-remover-cliente" title="Remover cliente"
                            onclick="removerCliente('${escaparHTML(c.id)}')">
                        <i class="fa-regular fa-trash-can"></i>
                    </button>
                </div>`;
        }).join('');
    }

    function filtrarClientes() { renderizarClientes(); }

    function removerCliente(id) {
        const c = getClientes().find(x => String(x.id) === String(id));
        if (!c) return;
        if (!confirm(`Remover "${c.nome}" da lista?`)) return;
        setClientes(getClientes().filter(x => String(x.id) !== String(id)));
        carregarClientes();
        atualizarStats();
        toast('🗑️ Cliente removido', `"${c.nome}" foi removido da lista.`);
    }

    function limparClientes() {
        if (!getClientes().length) { toast('ℹ️ Lista vazia', 'Não há clientes para remover.'); return; }
        if (!confirm('Remover TODOS os clientes da lista?')) return;
        setClientes([]);
        carregarClientes();
        atualizarStats();
        toast('🧹 Lista limpa!', 'Todos os clientes foram removidos da lista.');
    }

    let pollingTimer = null;

    function iniciarMonitor() {
        window.addEventListener('storage', onStorageChange);
        if (pollingTimer) clearInterval(pollingTimer);
        pollingTimer = setInterval(verificarNovidades, 2000);

        setInterval(() => {
            const antes = clientesCache.filter(estaOnline).length;
            atualizarBadgesClientes();
            const depois = clientesCache.filter(estaOnline).length;
            if (antes !== depois && document.getElementById('sec-clientes').classList.contains('active')) {
                renderizarClientes();
            }
        }, 30000);
    }

    function pararMonitor() {
        window.removeEventListener('storage', onStorageChange);
        if (pollingTimer) { clearInterval(pollingTimer); pollingTimer = null; }
    }

    function onStorageChange(e) {
        if (e.key === STORAGE_KEYS.clientes) verificarNovidades();
        if (e.key === STORAGE_KEYS.agendamentos) verificarNovidades();
    }

    function verificarNovidades() {
        verificarNovosClientes();
        verificarNovosAgendamentos();
    }

    function verificarNovosClientes() {
        const atuais = getClientes();
        if (primeiraCargaClientes) {
            clientesConhecidos = new Set(atuais.map(c => String(c.id)));
            primeiraCargaClientes = false;
            clientesCache = atuais;
            atualizarBadgesClientes();
            if (document.getElementById('sec-clientes').classList.contains('active')) renderizarClientes();
            return;
        }
        const novos = atuais.filter(c => !clientesConhecidos.has(String(c.id)));
        if (novos.length > 0) {
            novos.forEach(c => clientesConhecidos.add(String(c.id)));
            const n = novos[0];
            toast('🔔 Novo cliente logado!', `${n.nome || 'Alguém'} entrou na loja.`);
            if (!document.getElementById('sec-clientes').classList.contains('active')) {
                document.getElementById('badgeNovoCliente').style.display = 'block';
            }
            clientesCache = atuais;
            atualizarBadgesClientes();
            if (document.getElementById('sec-clientes').classList.contains('active')) renderizarClientes();
        } else {
            const mudou = JSON.stringify(atuais) !== JSON.stringify(clientesCache);
            if (mudou) {
                clientesCache = atuais;
                atualizarBadgesClientes();
                if (document.getElementById('sec-clientes').classList.contains('active')) renderizarClientes();
            }
        }
    }

    function verificarNovosAgendamentos() {
        const atuais = getAgendamentos();
        if (primeiraCargaAgend) {
            agendamentosConhecidos = new Set(atuais.map(a => String(a.id)));
            primeiraCargaAgend = false;
            agendamentosCache = atuais;
            atualizarContadoresAgend();
            if (document.getElementById('sec-agendamentos').classList.contains('active')) renderizarAgendamentos();
            return;
        }
        const novos = atuais.filter(a => !agendamentosConhecidos.has(String(a.id)));
        if (novos.length > 0) {
            novos.forEach(a => agendamentosConhecidos.add(String(a.id)));
            const n = novos[0];
            toast('📅 Novo agendamento!', `${n.clienteNome} agendou "${n.servico}" para ${formatarDataBR(n.data)} às ${n.hora}.`);
            if (!document.getElementById('sec-agendamentos').classList.contains('active')) {
                document.getElementById('badgeNovoAgend').style.display = 'block';
            }
            agendamentosCache = atuais;
            atualizarContadoresAgend();
            atualizarStats();
            if (document.getElementById('sec-agendamentos').classList.contains('active')) renderizarAgendamentos();
        } else {
            const mudou = JSON.stringify(atuais) !== JSON.stringify(agendamentosCache);
            if (mudou) {
                agendamentosCache = atuais;
                atualizarContadoresAgend();
                atualizarStats();
                if (document.getElementById('sec-agendamentos').classList.contains('active')) renderizarAgendamentos();
            }
        }
    }

    function carregarAvaliacoesAdmin() {
        const avaliacoes = getAvaliacoes();
        const container = document.getElementById('listaAvaliacoesAdmin');
        document.getElementById('avaliacoesBadge').textContent = avaliacoes.length;
        if (!avaliacoes.length) {
            container.innerHTML = `<div class="vazio"><i class="fa-regular fa-star"></i>Nenhuma avaliação ainda.</div>`;
            return;
        }
        container.innerHTML = avaliacoes.map((a, i) => {
            const estrelas = '★'.repeat(a.nota) + '☆'.repeat(5 - a.nota);
            return `
                <div class="avaliacao-admin-item">
                    <div class="header">
                        <span class="nome">${escaparHTML(a.nome)}</span>
                        <span class="estrelas">${estrelas}</span>
                        <span class="data">${escaparHTML(a.data || '')}</span>
                    </div>
                    <div class="texto"><strong>${escaparHTML(a.produto)}</strong> — ${escaparHTML(a.texto)}</div>
                    <div class="acoes">
                        <button class="btn-responder" onclick="responderAvaliacao(${i})">
                            <i class="fa-regular fa-reply"></i> Responder
                        </button>
                    </div>
                </div>`;
        }).join('');
    }

    function responderAvaliacao(index) {
        const a = getAvaliacoes()[index];
        if (!a) return;
        const resposta = prompt(`Responder avaliação de ${a.nome}:\n"${a.texto}"\n\nDigite sua resposta:`);
        if (!resposta?.trim()) return;
        const feedbacks = getFeedbacks();
        feedbacks.push({ nome: `💬 Luíza (resposta à ${a.nome})`, texto: resposta.trim() });
        setFeedbacks(feedbacks);
        carregarFeedbacksAdmin();
        atualizarStats();
        toast('📨 Resposta enviada!', 'A resposta foi adicionada aos feedbacks.');
    }

    function carregarFeedbacksAdmin() {
        const feedbacks = getFeedbacks();
        const container = document.getElementById('listaFeedbacksAdmin');
        document.getElementById('feedbacksBadge').textContent = feedbacks.length;
        if (!feedbacks.length) {
            container.innerHTML = `<div class="vazio"><i class="fa-regular fa-comment"></i>Nenhum feedback ainda.</div>`;
            return;
        }
        container.innerHTML = feedbacks.map((f, i) => {
            const isResposta = f.nome.includes('Luíza') || f.nome.includes('TC Beauty');
            return `
                <div class="feedback-admin-item">
                    <div class="header">
                        <span class="nome">${escaparHTML(f.nome)}</span>
                        ${isResposta ? '<span class="badge-resposta">📨 Resposta</span>' : ''}
                    </div>
                    <div class="texto">${escaparHTML(f.texto)}</div>
                    ${!isResposta ? `
                        <div class="acoes">
                            <button class="btn-responder" onclick="responderFeedbackAdmin(${i})">
                                <i class="fa-regular fa-reply"></i> Responder
                            </button>
                        </div>` : ''}
                </div>`;
        }).join('');
    }

    function responderFeedbackAdmin(index) {
        const f = getFeedbacks()[index];
        if (!f) return;
        const resposta = prompt(`Responder feedback de ${f.nome}:\n"${f.texto}"\n\nDigite sua resposta:`);
        if (!resposta?.trim()) return;
        const feedbacks = getFeedbacks();
        feedbacks.push({ nome: `💬 Luíza (resposta à ${f.nome})`, texto: resposta.trim() });
        setFeedbacks(feedbacks);
        carregarFeedbacksAdmin();
        toast('📨 Resposta enviada!', 'Sua resposta foi adicionada.');
    }

    function atualizarStats() {
        document.getElementById('statProdutos').textContent = getProdutos().length;
    }

    function abrirSecao(secao, btn) {
        document.querySelectorAll('.painel-section').forEach(s => s.classList.remove('active'));
        document.querySelectorAll('.painel-nav button').forEach(b => b.classList.remove('active'));
        document.getElementById('sec-' + secao).classList.add('active');
        if (btn) btn.classList.add('active');

        if (secao === 'produtos') carregarProdutos();
        if (secao === 'agendamentos') {
            carregarAgendamentos();
            document.getElementById('badgeNovoAgend').style.display = 'none';
        }
        if (secao === 'clientes') {
            carregarClientes();
            document.getElementById('badgeNovoCliente').style.display = 'none';
        }
        if (secao === 'avaliacoes') carregarAvaliacoesAdmin();
        if (secao === 'feedbacks') carregarFeedbacksAdmin();
    }

    function escaparHTML(str) {
        if (str == null) return '';
        return String(str)
            .replaceAll('&', '&amp;').replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;').replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function toast(titulo, texto) {
        const el = document.getElementById('toast');
        document.getElementById('toastTitulo').textContent = titulo;
        document.getElementById('toastTexto').textContent = texto;
        el.classList.add('mostrar');
        clearTimeout(el._timeout);
        el._timeout = setTimeout(() => el.classList.remove('mostrar'), 3500);
    }

    document.addEventListener('DOMContentLoaded', () => {
        initDados();
        document.getElementById('telaLogin').style.display = 'flex';
        document.getElementById('painel').style.display = 'none';
        document.getElementById('loginSenha').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') fazerLogin();
        });
        console.log('👩‍💼 TC Beauty — Painel ADM pronto com 30 produtos.');
    });

    Object.assign(window, {
        fazerLogin, sair, abrirSecao,
        abrirFormProduto, fecharFormProduto, salvarProduto, editarProduto, excluirProduto,
        responderAvaliacao, responderFeedbackAdmin,
        uploadImagemLocal, onUrlImagemChange, limparImagem, filtrarProdutos,
        filtrarClientes, removerCliente, limparClientes,
        setFiltroAgend, setPeriodoAgend, mudarStatusAgend, excluirAgendamento, limparAgendamentos,
        toast
    });
    </script>

</body>
</html>
