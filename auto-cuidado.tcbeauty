<div class="toast" id="toast"><b>✨ Sucesso!</b> Ação realizada com sucesso.</div>

<script>
// ===== LÓGICA DOS CARDS E BUSCA (Original) =====
function showGroup(group,el){
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('#productGrid .card').forEach(card=>{
    card.style.display=(group==='all'||card.dataset.tags.includes(group))?'block':'none';
  });
}
function filterCards(){
  const q=document.getElementById('search').value.toLowerCase().trim();
  document.querySelectorAll('.card').forEach(card=>{
    card.style.display=(!q||card.innerText.toLowerCase().includes(q))?'block':'none';
  });
}
document.querySelectorAll('.icon').forEach(icon=>icon.addEventListener('click',()=>{
  const t=document.getElementById('toast');t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1800);
}));

// ===== MODO CLARO / ESCURO =====
function toggleTheme() {
  document.body.classList.toggle('light-mode');
  const isLight = document.body.classList.contains('light-mode');
  document.getElementById('themeBtn').innerText = isLight ? '☀️' : '🌙';
  localStorage.setItem('tc_tema', isLight ? 'light' : 'dark');
}
if (localStorage.getItem('tc_tema') === 'light') {
  document.body.classList.add('light-mode');
  document.getElementById('themeBtn').innerText = '☀️';
}

// ===== BOTÃO VOLTAR AO TOPO =====
window.addEventListener('scroll', () => {
  const btn = document.getElementById('btnTopo');
  if (window.scrollY > 300) {
    btn.classList.add('show');
  } else {
    btn.classList.remove('show');
  }
});

// ===== LÓGICA DOS QUIZZES =====
