let votos = {};

function irParaQuiz(tipo) {
  quizAtual = QUIZZES[tipo];
  perguntaIdx = 0;
  votos = {};
  Object.keys(quizAtual.res).forEach(k => votos[k] = 0);
  document.getElementById('quizContainer').style.display = 'block';
  document.getElementById('quizTitle').innerText = quizAtual.titulo;
  document.getElementById('quizContainer').scrollIntoView({behavior: 'smooth'});
  renderizarPergunta();
}

function renderizarPergunta() {
  const div = document.getElementById('quizContent');
  if (perguntaIdx >= quizAtual.perguntas.length) {
    renderizarResultado();
    return;
  }
  const p = quizAtual.perguntas[perguntaIdx];
  let html = `<p style="font-size:12px; color:#ffc21a; margin-bottom:10px;">Pergunta ${perguntaIdx+1} de ${quizAtual.perguntas.length}</p>`;
  html += `<h4 style="margin-bottom:15px;">${p.q}</h4>`;
  p.o.forEach((op, i) => {
    html += `<button class="quiz-btn" onclick="responderQuiz(${i})">${op.t}</button>`;
  });
  div.innerHTML = html;
}

function responderQuiz(idx) {
  const opcao = quizAtual.perguntas[perguntaIdx].o[idx];
  votos[opcao.tipo]++;
  perguntaIdx++;
  renderizarPergunta();
}

function renderizarResultado() {
  const vencedor = Object.keys(votos).reduce((a, b) => votos[a] >= votos[b] ? a : b);
  const r = quizAtual.res[vencedor];
  const msg = `Fiz o quiz da TC Beauty e descobri: ${r.nome}! Faça o seu também.`;
  const linkWpp = `https://wa.me/?text=${encodeURIComponent(msg)}`;
  
  let html = `<div style="text-align:center;">
    <span style="background:rgba(255,22,141,0.15); color:#ff168d; padding:5px 15px; border-radius:20px; font-size:10px; letter-spacing:2px; text-transform:uppercase; font-weight:bold;">Seu resultado</span>
    <h3 style="color:#ffc21a; font-size:24px; margin:15px 0;">${r.nome}</h3>
    <p style="color:#aaa; font-size:14px; text-align:left; margin-bottom:15px;">${r.desc}</p>
    <div style="background:#0a0a0a; border-left:3px solid #ff168d; padding:15px; border-radius:0 10px 10px 0; text-align:left; margin-bottom:20px;">
      <h4 style="color:#ffc21a; margin-bottom:10px;">O que você pode fazer</h4>
      <ul style="color:#aaa; font-size:13px; padding-left:20px;">
        ${r.dicas.map(d => `<li style="margin-bottom:5px;">${d}</li>`).join('')}
      </ul>
    </div>
    <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
      <a href="${linkWpp}" target="_blank" style="background:#25d366; color:#fff; padding:10px 20px; border-radius:20px; text-decoration:none; font-weight:bold; font-size:13px;">Compartilhar no WhatsApp</a>
      <button onclick="irParaQuiz('${Object.keys(QUIZZES).find(k => QUIZZES[k] === quizAtual)}')" style="background:transparent; color:#ff168d; border:1px solid #ff168d; padding:10px 20px; border-radius:20px; font-weight:bold; font-size:13px; cursor:pointer;">Refazer Quiz</button>
    </div>
  </div>`;
  document.getElementById('quizContent').innerHTML = html;
}

// ===== LÓGICA DO CALENDÁRIO MENSTRUAL =====
function calcCalendario() {
  const dataInput = document.getElementById('calData').value;
  const duracao = parseInt(document.getElementById('calDuracao').value) || 28;
  const res = document.getElementById('calResultado');
  const grade = document.getElementById('calGrade');
  
  if (!dataInput) {
    res.innerHTML = '<p style="color:#aaa; font-size:12px;">Escolha a data.</p>';
    grade.innerHTML = '';
    return;
  }
  
  const inicio = new Date(dataInput + 'T00:00:00');
  const hoje = new Date(); hoje.setHours(0,0,0,0);
  let dias = [];
  
  for (let i = 0; i < duracao; i++) {
    const d = new Date(inicio);
    d.setDate(d.getDate() + i);
    let fase = '';
    if (i < 5) fase = 'menstrual';
    else if (i >= 9 && i <= 14) fase = 'fertil';
    if (i === 13) fase = 'ovulacao';
    dias.push({ data: d, fase });
  }
  
  const proxMenstruacao = new Date(inicio); proxMenstruacao.setDate(proxMenstruacao.getDate() + duracao);
  const dataFertilIni = new Date(inicio); dataFertilIni.setDate(dataFertilIni.getDate() + 9);
  const dataFertilFim = new Date(inicio); dataFertilFim.setDate(dataFertilFim.getDate() + 14);
  const fmt = (d) => d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });
  
  res.innerHTML = `
    <div style="background:#0a0a0a; padding:10px; border-radius:8px; border-left:3px solid #ff168d; text-align:center; flex:1; min-width:120px;">
      <div style="font-size:10px; color:#aaa;">Próxima menstruação</div>
      <div style="font-size:14px; font-weight:bold;">${fmt(proxMenstruacao)}</div>
    </div>
    <div style="background:#0a0a0a; padding:10px; border-radius:8px; border-left:3px solid #ffc21a; text-align:center; flex:1; min-width:120px;">
      <div style="font-size:10px; color:#aaa;">Período fértil</div>
      <div style="font-size:14px; font-weight:bold;">${fmt(dataFertilIni)} a ${fmt(dataFertilFim)}</div>
    </div>
    <div style="background:#0a0a0a; padding:10px; border-radius:8px; border-left:3px solid #26a69a; text-align:center; flex:1; min-width:120px;">
      <div style="font-size:10px; color:#aaa;">Duração</div>
      <div style="font-size:14px; font-weight:bold;">${duracao} dias</div>
    </div>
  `;
  
  grade.innerHTML = dias.map(({ data, fase }) => {
    const classe = `cal-dia ${fase}`;
    return `<div class="${classe}">${data.getDate()}</div>`;
  }).join('');
}

// ===== LÓGICA DOS DEPOIMENTOS =====
let estrelas = 0;
function setStars(n) {
  estrelas = n;
  const spans = document.querySelectorAll('#depEstrelas span');
  spans.forEach((s, i) => {
    s.style.color = i < n ? '#ffc21a' : '#333';
  });
}

function enviarDepoimento() {
  const nome = document.getElementById('depNome').value.trim();
  const texto = document.getElementById('depTexto').value.trim();
  
  if (!nome || !texto || estrelas === 0) {
    alert('Preencha nome, avaliação e depoimento.');
    return;
  }
  
  const lista = JSON.parse(localStorage.getItem('tc_depoimentos') || '[]');
  lista.unshift({ nome, texto, estrelas, data: new Date().toLocaleDateString('pt-BR') });
  localStorage.setItem('tc_depoimentos', JSON.stringify(lista));
  
  document.getElementById('depNome').value = '';
  document.getElementById('depTexto').value = '';
  setStars(0);
  renderizarDepoimentos();
  alert('Obrigada! Seu depoimento foi enviado.');
}

function renderizarDepoimentos() {
  const div = document.getElementById('listaDepoimentos');
  const lista = JSON.parse(localStorage.getItem('tc_depoimentos') || '[]');
  
  if (lista.length === 0) {
    div.innerHTML = '<p style="text-align:center; color:#aaa; font-size:13px;">Nenhum depoimento ainda. Seja a primeira!</p>';
    return;
  }
  
  div.innerHTML = lista.map(d => `
    <div class="depoimento-card">
      <div class="depoimento-topo">
        <strong style="color:#fff;">${d.nome}</strong>
        <span style="color:#aaa; font-size:11px;">${d.data}</span>
      </div>
      <div style="color:#ffc21a; font-size:14px; margin-bottom:5px;">${'★'.repeat(d.estrelas)}${'☆'.repeat(5 - d.estrelas)}</div>
      <p style="color:#aaa; font-size:13px; margin:0;">${d.texto}</p>
    </div>
  `).join('');
}

// Inicializar depoimentos ao carregar
document.addEventListener('DOMContentLoaded', () => {
  renderizarDepoimentos();
});
</script>
</body>
</html>
