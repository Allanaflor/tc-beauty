<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#ff168d">
<title>TC Beauty — Auto Cuidado</title>

<!-- Fontes -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Playfair+Display:ital@1&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#080708;--panel:#121012;--panel2:#171417;--line:#292229;
  --pink:#ff168d;--pink2:#ff49ad;--rose:#f3b7c7;--muted:#aaa2a9;
  --white:#fff;--gold:#ffc21a;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:#fff;font-family:'Poppins',sans-serif;transition:background .3s,color .3s}
a{color:inherit;text-decoration:none}
button,input,textarea{font:inherit}
.container{width:min(1320px,calc(100% - 42px));margin:auto}

/* Modo Claro */
body.light-mode { --bg: #fdf8f5; --panel: #ffffff; --line: #e8ddd8; color: #3a2e2a; }
body.light-mode .header { background: #fff; }
body.light-mode .card, body.light-mode .cat, body.light-mode .routine-card { background: #ffffff; color: #3a2e2a; }
body.light-mode .card p, body.light-mode .routine-card p { color: #7a6565; }
body.light-mode .header-nav a { color: #555; }

/* Barra de Frete Grátis */
.frete-gratis { background: var(--pink); color: #fff; text-align: center; padding: 8px; font-size: 12px; font-weight: 700; letter-spacing: 1px; }

/* top promo */
.topline{height:34px;background:#090809;border-bottom:1px solid #1d191d;display:flex;align-items:center;justify-content:center;color:#d9d2d8;font-size:12px;letter-spacing:.3px}
.topline b{color:var(--pink);margin:0 4px}

/* header */
.header{background:#0d0c0d;border-bottom:1px solid #242024;position:sticky;top:0;z-index:50}
.header-row{height:76px;display:flex;align-items:center;gap:24px}
.brand{display:flex;align-items:center;gap:10px;min-width:185px}
.brand img{width:44px;height:44px;object-fit:cover;border-radius:50%;box-shadow:0 0 20px rgba(255,22,141,.22)}
.brand-name{font-weight:800;font-size:25px;color:var(--pink);letter-spacing:-1px}
.brand-name span{color:#fff}

/* MENU ARRUMADO (SEM BARRA FEIA) */
.header-nav {
  display: flex;
  gap: 15px;
  align-items: center;
  font-size: 13px;
  color: #c6c0c5;
  white-space: nowrap;
  overflow-x: auto;
  padding-bottom: 5px;
  -ms-overflow-style: none; /* IE and Edge */
  scrollbar-width: none; /* Firefox */
}
.header-nav::-webkit-scrollbar {
  display: none; /* Chrome, Safari and Opera */
}
.header-nav a:hover {
  color: var(--pink);
}

.search{margin-left:auto;display:flex;align-items:center;background:#181619;border:1px solid #29262a;border-radius:28px;height:43px;width:min(330px,28vw);padding:0 9px 0 17px}
.search input{background:none;border:0;outline:0;color:#eee;width:100%;font-size:13px}
.search button{border:0;background:var(--pink);color:#fff;width:34px;height:34px;border-radius:50%;cursor:pointer}
.icons{display:flex;gap:13px;color:#d4cdd2;font-size:19px;align-items:center}
.icon{position:relative;cursor:pointer}
.badge{position:absolute;top:-9px;right:-8px;background:var(--pink);color:#fff;border-radius:50%;font-size:9px;min-width:16px;height:16px;display:grid;place-items:center;font-weight:800}

/* Toggle de Tema */
.theme-toggle{background:transparent;border:1px solid var(--line);color:var(--pink);width:35px;height:35px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;transition:.3s}
.theme-toggle:hover{background:var(--pink);color:#fff}

/* hero */
.hero{padding:20px 0 0}
.hero-frame{height:390px;border:1px solid #281d26;border-radius:18px;overflow:hidden;position:relative;background:#110a0f}
.hero-frame img{width:100%;height:100%;object-fit:cover;display:block}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,4,5,.65),rgba(5,4,5,.04) 65%)}
.hero-copy{position:absolute;left:46px;top:50%;transform:translateY(-50%);max-width:500px}
.kicker{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#ff77bc;font-weight:800}
.hero h1{font-size:46px;line-height:1.05;margin:10px 0 10px;letter-spacing:-1.5px}
.hero p{color:#ddd5db;line-height:1.6;font-size:15px;max-width:440px;margin:0 0 20px}
.btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:24px;padding:13px 22px;background:var(--pink);color:#fff;font-weight:800;font-size:13px;box-shadow:0 10px 28px rgba(255,22,141,.22);cursor:pointer}
.btn:hover{background:#ff43aa}

/* section headings */
.section{padding:48px 0}
.heading{text-align:center;margin-bottom:26px}
.heading h2{font-size:28px;margin:0 0 10px}
.heading h2:after{content:"";display:block;width:50px;height:3px;background:var(--pink);margin:12px auto 0;border-radius:10px}
.heading p{color:#aaa3aa;font-size:13px;margin:0}

/* category row */
.categories{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
.cat{min-width:120px;height:76px;border:1px solid #282328;background:#121012;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px;color:#d8d0d6;font-size:12px;font-weight:700;transition:.2s;text-align:center;padding:10px;cursor:pointer}
.cat:hover{border-color:#6c214d;transform:translateY(-2px);color:#fff}
.cat .emoji{font-size:20px;color:var(--pink)}

/* quick routine */
.routine{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.routine-card{background:linear-gradient(145deg,#171217,#100e10);border:1px solid #2b2028;border-radius:14px;padding:20px;min-height:155px;position:relative;overflow:hidden}
.routine-card:after{content:"";position:absolute;width:100px;height:100px;border-radius:50%;right:-30px;bottom:-35px;background:rgba(255,22,141,.08)}
.step{color:var(--pink);font-weight:900;font-size:12px;letter-spacing:1px;position:relative;z-index:1}
.routine-card h3{margin:10px 0 7px;font-size:17px;position:relative;z-index:1}
.routine-card p{margin:0;color:#a9a1a8;font-size:12px;line-height:1.6;position:relative;z-index:1}

/* product-like cards */
.tabs{display:flex;gap:10px;justify-content:center;margin-bottom:24px;flex-wrap:wrap}
.tab{background:#151215;border:1px solid #2a2429;color:#c8c0c6;border-radius:22px;padding:10px 16px;font-size:11px;font-weight:800;cursor:pointer}
.tab.active,.tab:hover{background:#4b1235;border-color:#7b1b55;color:#fff}
.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.card{background:#141214;border:1px solid #262226;border-radius:13px;overflow:hidden;min-width:0;transition:.2s}
.card:hover{transform:translateY(-4px);border-color:#6d1d4d;box-shadow:0 16px 35px rgba(0,0,0,.35)}
.card-img{height:175px;background:linear-gradient(135deg,#2a1d23,#100d0f);position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
.card-img:before{content:"";position:absolute;width:150px;height:150px;background:radial-gradient(circle,rgba(255,28,143,.26),transparent 65%);}
.product-visual{position:relative;width:74px;height:112px;border-radius:10px 10px 13px 13px;background:linear-gradient(135deg,#e9a6ad,#fff0e8 45%,#8b3a55);box-shadow:0 10px 25px #0008;display:flex;align-items:center;justify-content:center;color:#35151f;font-size:9px;font-weight:900;text-align:center;padding:4px}
.product-visual.square{width:112px;height:82px;border-radius:12px}
.product-visual.bottle{height:125px;width:62px;border-radius:8px 8px 17px 17px}
.product-visual.bottle:before{content:"";position:absolute;top:-12px;width:25px;height:15px;background:#8b5b4d;border-radius:5px 5px 2px 2px}
.pill{position:absolute;left:10px;top:10px;background:var(--pink);color:#fff;padding:6px 8px;border-radius:8px;font-size:9px;font-weight:900;z-index:2}
.card-body{padding:14px}
.card h3{font-size:14px;margin:0 0 7px;line-height:1.25}
.card .type{font-size:11px;color:#a59da4;margin-bottom:9px}
.card p{font-size:11px;color:#8e878d;line-height:1.45;min-height:32px;margin:0}
.card-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:13px;gap:8px;flex-wrap:wrap}
.price{color:var(--pink);font-size:13px;font-weight:900}
.video-links{display:flex;gap:5px;flex-wrap:wrap}
.video,.video-links a{border:1px solid var(--pink);color:#fff;border-radius:20px;padding:6px 9px;font-size:9px;font-weight:800;background:transparent;text-decoration:none}
.video:hover,.video-links a:hover{background:var(--pink)}

/* featured banner */
.feature{margin-top:15px;background:linear-gradient(100deg,#1c0a15,#0d0c0e 65%);border:1px solid #2d1825;border-radius:16px;padding:30px 36px;display:flex;align-items:center;justify-content:space-between;gap:30px}
.feature h2{font-size:28px;margin:0 0 7px}
.feature h2 span{color:var(--pink)}
.feature p{color:#aaa2a9;font-size:13px;margin:0;line-height:1.6}
.feature-icon{font-size:54px;color:var(--pink)}

/* video library */
.video-library{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.video-card{background:#141214;border:1px solid #262226;border-radius:14px;padding:20px}
.video-card .play{width:34px;height:34px;border-radius:50%;background:#4b1235;color:#fff;display:grid;place-items:center;font-size:11px;margin-bottom:12px}
.video-card h3{font-size:14px;margin:0 0 6px}
.video-card p{font-size:11px;color:#a59da4;line-height:1.5;margin:0 0 12px}
.video-card a{font-size:11px;color:var(--pink);font-weight:700}

/* toast + nav bottom */
.toast{position:fixed;left:50%;bottom:25px;transform:translateX(-50%);background:#171417;border:1px solid #3b2433;border-radius:12px;padding:14px 22px;z-index:80;box-shadow:0 12px 30px #0009;opacity:0;pointer-events:none;transition:.25s}
.toast.show{opacity:1}
.toast b{color:var(--pink)}

footer{margin-top:30px;background:#0c0b0c;border-top:1px solid #211d21;padding:38px 0;color:#8f888f;font-size:12px}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:30px}
.footer-title{font-size:22px;color:var(--pink);font-weight:900;margin-bottom:9px}
footer h4{color:#eee;margin:0 0 12px;font-size:12px}
footer a{display:block;margin:7px 0;color:#8f888f}
footer a:hover{color:#fff}
.copyright{border-top:1px solid #211d21;margin-top:28px;padding-top:20px;font-size:10px}

/* ===== NOVOS ESTILOS (Quizzes, Ciclo, FAQ, Depoimentos) ===== */
.faq-item.open .faq-resposta { display: block !important; }
.faq-item.open h3 span { transform: rotate(180deg); display: inline-block; }
.cal-dia { padding: 8px 0; text-align: center; font-size: 12px; border-radius: 6px; background: #171417; color: #aaa; }
.cal-dia.vazio { background: transparent; }
.cal-dia.menstrual { background: rgba(229,57,53,.25); color: #ff8a80; font-weight:bold; }
.cal-dia.fertil { background: rgba(255,194,26,.2); color: #ffc21a; font-weight:bold; }
.cal-dia.ovulacao { background: rgba(255,22,141,.2); color: #ff168d; font-weight:bold; }
.depoimento-card { background: #141214; border: 1px solid #262226; border-left: 3px solid #ff168d; border-radius: 10px; padding: 15px; margin-bottom: 10px; }
.depoimento-topo { display: flex; justify-content: space-between; margin-bottom: 5px; }
.quiz-btn { display:block; width:100%; text-align:left; background:#0a0a0a; border:1px solid #333; color:#fff; padding:12px; margin-bottom:8px; border-radius:8px; cursor:pointer; transition:.2s; }
.quiz-btn:hover { border-color: var(--pink); color: var(--pink); }

/* Botões Flutuantes */
.float-buttons { position: fixed; bottom: 30px; right: 30px; display: flex; flex-direction: column; gap: 15px; z-index: 999; }
.float-btn { width: 55px; height: 55px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 24px; text-decoration: none; box-shadow: 0 4px 15px rgba(0,0,0,0.3); transition: 0.3s; border: none; cursor: pointer; }
.float-btn:hover { transform: scale(1.1) translateY(-3px); }
.btn-whats { background: #25d366; }
.btn-loja { background: var(--pink); }
.btn-topo { background: #333; display: none; font-size: 20px; }
.btn-topo.show { display: flex; }

/* responsive */
@media(max-width:1050px){
 .header-nav{display:none}
 .grid{grid-template-columns:repeat(3,1fr)}
 .routine{grid-template-columns:repeat(2,1fr)}
 .search{width:330px}
 .video-library{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:700px){
 .container{width:min(100% - 24px,1320px)}
 .header-row{height:68px}
 .brand-name{font-size:21px}
 .search{width:180px}
 .icons{display:none}
 .hero-frame{height:430px}
 .hero-copy{left:25px;right:25px}
 .hero h1{font-size:36px}
 .grid{grid-template-columns:repeat(2,1fr);gap:10px}
 .card-img{height:145px}
 .feature{padding:24px;flex-direction:column;align-items:flex-start}
 .footer-grid{grid-template-columns:1fr}
 .video-library{grid-template-columns:1fr}
}
@media(max-width:450px){
 .search{display:none}
 .brand{min-width:auto}
 .routine{grid-template-columns:1fr}
 .grid{grid-template-columns:1fr 1fr}
 .card-img{height:130px}
 .hero-frame{height:390px}
 .hero h1{font-size:32px}
 .hero p{font-size:13px}
 .cat{min-width:calc(50% - 8px)}
}
</style>
</head>
<body>

<div class="frete-gratis">✨ FRETE GRÁTIS ACIMA DE R$ 150 ✨</div>
<div class="topline">✨ <b>TC Beauty</b> — seu guia de beleza, estilo e autocuidado</div>

<header class="header">
  <div class="container header-row">
    <a href="#" class="brand">
      <img src="logo.jpeg" alt="TC Beauty">
      <div class="brand-name">TC <span>Beauty</span></div>
    </a>

    <nav class="header-nav">
      <a href="#inicio">Início</a>
      <a href="#rotina">Rotinas</a>
      <a href="#pele">Pele</a>
      <a href="#cabelos">Cabelos</a>
      <a href="#make">Maquiagem</a>
      <a href="#unhas">Unhas</a>
      <a href="#corpo">Corpo</a>
      <a href="#bem-estar">Bem-estar</a>
      <a href="#quizzes">Quizzes</a>
      <a href="#ciclo">Ciclo</a>
      <a href="#fundadoras">Fundadoras</a>
    </nav>

    <div class="search">
      <input id="search" placeholder="Pesquisar..." oninput="filterCards()">
      <button onclick="filterCards()">⌕</button>
    </div>
    
    <div class="icons">
      <button class="theme-toggle" onclick="toggleTheme()" id="themeBtn" title="Mudar tema">🌙</button>
      <span class="icon">♡</span>
      <span class="icon">♧<i class="badge">1</i></span>
      <span class="icon">♙</span>
    </div>
  </div>
</header>

<main id="inicio">
<section class="hero">
  <div class="container">
    <div class="hero-frame">
      <img src="logo2.jpeg" alt="TC Beauty — beleza, estilo e confiança">
      <div class="hero-overlay"></div>
      <div class="hero-copy">
        <div class="kicker">Guia de autocuidado</div>
        <h1>Realçando sua beleza<br>com carinho e confiança.</h1>
        <p>Descubra ideias de rotina, cuidados para pele e cabelos, maquiagem e inspiração para o seu momento de autocuidado.</p>
        <a class="btn" href="#rotina">Começar agora ✦</a>
      </div>
    </div>
  </div>
</section>

<section class="section" id="categorias">
  <div class="container">
    <div class="heading">
      <h2>Categorias</h2>
      <p>Encontre rapidamente o conteúdo que você quer explorar.</p>
    </div>
    <div class="categories">
      <a class="cat" href="#pele"><span class="emoji">♡</span>Pele</a>
      <a class="cat" href="#cabelos"><span class="emoji">〰</span>Cabelos</a>
      <a class="cat" href="#make"><span class="emoji">✧</span>Maquiagem</a>
      <a class="cat" href="#unhas"><span class="emoji">✦</span>Unhas</a>
      <a class="cat" href="#corpo"><span class="emoji">◌</span>Corpo & Banho</a>
      <a class="cat" href="#bem-estar"><span class="emoji">♡</span>Bem-estar</a>
      <a class="cat" href="#rotina"><span class="emoji">☼</span>Rotinas</a>
      <a class="cat" href="#videos"><span class="emoji">▶</span>Vídeos</a>
    </div>
  </div>
</section>

<section class="section" id="rotina">
  <div class="container">
    <div class="heading">
      <h2>Monte seu momento de autocuidado</h2>
      <p>Uma sequência simples para transformar o cuidado em hábito.</p>
    </div>
    <div class="routine">
      <div class="routine-card"><div class="step">01 · PREPARAR</div><h3>Limpar</h3><p>Comece com uma limpeza suave e deixe a pele pronta para os próximos passos.</p></div>
      <div class="routine-card"><div class="step">02 · CUIDAR</div><h3>Hidratar</h3><p>Escolha produtos que façam sentido para a sua rotina e para as necessidades da sua pele.</p></div>
      <div class="routine-card"><div class="step">03 · FINALIZAR</div><h3>Proteger</h3><p>Durante o dia, inclua proteção solar e mantenha seus cuidados de forma constante.</p></div>
      <div class="routine-card"><div class="step">04 · VOCÊ</div><h3>Relaxar</h3><p>Reserve um tempo para cabelo, maquiagem, banho, skincare ou simplesmente descansar.</p></div>
    </div>
  </div>
</section>

<section class="section" id="pele">
  <div class="container">
    <div class="heading">
      <h2>Pele</h2>
      <p>Conteúdos para diferentes rotinas e necessidades de cuidado.</p>
    </div>
    <div class="tabs">
      <button class="tab active" onclick="showGroup('all',this)">Tudo</button>
      <button class="tab" onclick="showGroup('pele',this)">Pele</button>
      <button class="tab" onclick="showGroup('skincare',this)">Skincare</button>
    </div>
    <div class="grid" id="productGrid">
      <article class="card" data-tags="pele skincare">
        <div class="card-img"><span class="pill">ROTINA</span><div class="product-visual bottle">HYDRATE</div></div>
        <div class="card-body"><h3>Skincare para iniciantes</h3><div class="type">Limpeza · hidratação · proteção</div><p>Aprenda uma rotina simples e organizada para começar.</p><div class="card-bottom"><div class="price">Guia</div><div class="video-links"><a class="video" target="_blank" rel="noopener" href="https://www.youtube.com/results?search_query=skincare+para+iniciantes+passo+a+passo">Vídeos</a></div></div></div>
      </article>
      <article class="card" data-tags="pele">
        <div class="card-img"><span class="pill">HIDRATAÇÃO</span><div class="product-visual">GLOW<br>CREAM</div></div>
        <div class="card-body"><h3>Pele seca</h3><div class="type">Conforto · hidratação</div><p>Ideias para uma rotina de cuidados com pele seca.</p><div class="card-bottom"><div class="price">Guia</div><div class="video-links"><a class="video" target="_blank" rel="noopener" href="https://www.youtube.com/results?search_query=rotina+pele+seca+hidratacao">Vídeos</a></div></div></div>
      </article>
      <article class="card" data-tags="pele skincare">
        <div class="card-img"><span class="pill">PELE</span><div class="product-visual square">GLOW<br>SKIN</div></div>
        <div class="card-body"><h3>Pele oleosa</h3><div class="type">Limpeza · hidratação</div><p>Conteúdos para organizar uma rotina de pele oleosa.</p><div class="card-bottom"><div class="price">Guia</div><div class="video-links"><a class="video" target="_blank" rel="noopener" href="https://www.youtube.com/results?search_query=dermatologista+rotina+pele+oleosa">Vídeos</a></div></div></div>
      </article>
      <article class="card" data-tags="pele">
        <div class="card-img"><span class="pill">PROTEÇÃO</span><div class="product-visual bottle">SUN<br>CARE</div></div>
        <div class="card-body"><h3>Proteção solar</h3><div class="type">Cuidados diurnos</div><p>Entenda o lugar do protetor solar na rotina diária.</p><div class="card-bottom"><div class="price">Guia</div><div class="video-links"><a class="video" target="_blank" rel="noopener" href="https://www.youtube.com/results?search_query=protetor+solar+dermatologista+como+usar">Vídeos</a></div></div></div>
      </article>
      <article class="card" data-tags="pele">
        <div class="card-img"><span class="pill">PELE NEGRA</span><div class="product-visual">CARE<br>GLOW</div></div>
        <div class="card-body"><h3>Cuidados para pele negra</h3><div class="type">Hidratação · manchas · proteção</div><p>Conteúdos específicos para conhecer melhor os cuidados.</p><div class="card-bottom"><div class="price">Guia</div><div class="video-links"><a class="video" target="_blank" rel="noopener" href="https://www.youtube.com/results?search_query=cuidados+pele+negra+skincare">Vídeos</a></div></div></div>
      </article>
    </div>
  </div>
</section>

<section class="section" id="cabelos">
  <div class="container">
    <div class="heading">
      <h2>Cabelos</h2>
      <p>Escolha sua textura e encontre conteúdos de cuidado, finalização e inspiração.</p>
    </div>
    <div class="grid">
